# Phase 2 is intentionally disabled until the app has user authentication.
MACROSNAP_AI_ENABLED=false

# Private beta is allowed only in local development or Vercel Preview deployments.
# Vercel production remains hard-disabled even if this is accidentally set to true.
MACROSNAP_BETA_ENABLED=false

# Secret values. Generate high-entropy codes, store only their SHA-256 hashes here,
# and use a random session secret containing at least 32 bytes.
MACROSNAP_BETA_CODE_HASHES_JSON=
MACROSNAP_SESSION_SECRET=

# Durable shared limits. Each tester is hard-limited to 10 analyses per UTC day.
MACROSNAP_BETA_GLOBAL_DAILY_LIMIT=100
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only. Never expose this variable through NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Keep these current with the configured model's published pricing.
# If omitted, token usage is tracked and estimated cost is reported as unavailable.
OPENAI_GPT6_LUNA_INPUT_USD_PER_MILLION=
OPENAI_GPT6_LUNA_OUTPUT_USD_PER_MILLION=
